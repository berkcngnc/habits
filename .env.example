# Habits App — Environment Variables
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin.
# .env dosyası asla git'e commit edilmez.

# AdMob App ID'leri (app.config.js tarafından okunur)
# AdMob konsolundan alınır: https://admob.google.com
ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# AdMob Production Unit ID'leri (Android)
EXPO_PUBLIC_AD_INTERSTITIAL=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_AD_REWARDED=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_AD_NATIVE=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
